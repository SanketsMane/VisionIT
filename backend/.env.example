# ─────────────────────────────────────────────────────────────────────────────
#  Vision IT Infra — Backend environment (local development)
#  Generated 2026-08-20. Never commit this file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# 5000 is taken by macOS AirPlay Receiver and 5050 by another local project.
PORT=5055
# Bind address. Loopback by default — keep it there when nginx fronts the app.
HOST=127.0.0.1
API_PREFIX=/api/v1
APP_NAME="Vision IT Infra"

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vision_it_infra?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vision_it_infra_shadow?schema=public"
DATABASE_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-64-random-chars-run-openssl-rand-base64-48"
JWT_REFRESH_SECRET="replace-with-a-different-64-random-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# 32-byte hex key used to AES-256-GCM encrypt SMTP passwords and provider keys.
# Rotating this makes every stored mailbox credential unreadable.
ENCRYPTION_KEY="replace-with-64-hex-chars-run-openssl-rand-hex-32"

# ── Frontend / CORS ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── OpenAI (AI email writer) ─────────────────────────────────────────────────
# Leave blank to run without AI — every other feature keeps working and the
# AI endpoints return a clear 503.
OPENAI_API_KEY=
# gpt-4.1 drafts email well and returns clean JSON in ~3s. gpt-5 also
# works — the client adjusts its parameters automatically — but it is
# slower, because reasoning tokens are billed and counted as output.
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=1600
OPENAI_TEMPERATURE=0.7

# ── Outbound email ───────────────────────────────────────────────────────────
# Optional process-wide fallback. Per-user mailboxes configured in the app UI
# take precedence over these.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="Vision IT Infra"
# A mailbox on a domain verified at resend.com/domains. Until one is verified,
# `onboarding@resend.dev` works but only delivers to the Resend account owner.
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_REPLY_TO=
# Publicly reachable URL of the email logo. Mail clients fetch it server-side,
# so a localhost URL renders nothing; leave blank to use the text wordmark.
MAIL_LOGO_URL=

# Resend — used when no SMTP mailbox is set. The shared `onboarding@resend.dev`
# sender works without a verified domain but only delivers to the address that
# owns the Resend account; verify your own domain to email clients.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
PUBLIC_BASE_URL=http://localhost:5055

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
# Leave blank to use the built-in default: 3000 in development, 300 in production.
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=20

# ── Ops ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENABLE_CRON=true

# ---- Seed --------------------------------------------------------------
# Used only by `npm run db:seed` to provision the owner account.
# SEED_OWNER_PASSWORD has no default — the seed refuses to run without it.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME="Workspace Owner"
SEED_BUSINESS_NAME="Vision IT Infra"

# Public self-service sign-up. Leave false: clients join through invitation
# links, and an open /register lets anyone create a workspace on this host.
ALLOW_PUBLIC_REGISTRATION=false
