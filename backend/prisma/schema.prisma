// ============================================================================
// CLIENT PORTAL
//
// Everything below belongs to a Project Workspace. Access is never granted by
// knowing an id — it is granted by a ProjectMember row, checked on every
// request. See `middlewares/project-access.middleware.ts`.
// ============================================================================

enum UserType {
  INTERNAL
  CLIENT
}

/// Permissions are derived from these, never stored per-user.
enum ProjectRole {
  CLIENT_OWNER
  CLIENT_MANAGER
  TESTER
  VIEWER
  INTERNAL_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProjectDeliveryStatus {
  NOT_STARTED
  PREPARING
  READY_FOR_CLIENT
  CLIENT_REVIEWING
  OWNERSHIP_TRANSFER
  DELIVERED
  COMPLETED
}

enum SourceCodeMethod {
  NOT_CHOSEN
  GITHUB
  ZIP
}

enum HandoverStatus {
  NOT_STARTED
  CLIENT_DETAILS_SUBMITTED
  TRANSFER_IN_PROGRESS
  ADMIN_CONFIRMED
  CLIENT_CONFIRMED
  COMPLETED
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Severity is impact; priority is urgency. Kept separate on purpose — a
/// cosmetic bug on the checkout page can be high priority but low severity.
enum BugSeverity {
  COSMETIC
  MINOR
  MAJOR
  CRITICAL
  BLOCKER
}

enum BugStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  FIXED
  READY_FOR_RETEST
  RETESTED
  CLOSED
  REJECTED
  DUPLICATE
  CANNOT_REPRODUCE
  DEFERRED
}

enum DocumentCategory {
  PROPOSAL
  AGREEMENT
  SOW
  REQUIREMENTS
  DESIGN
  TECHNICAL_DOC
  USER_DOC
  TESTING_REPORT
  DEPLOYMENT_DOC
  CREDENTIALS
  FINAL_REPORT
  INVOICE
  RECEIPT
  BUILD
  SOURCE_CODE
  OTHER
}

enum DocumentVisibility {
  ADMIN_ONLY
  CLIENT_VISIBLE
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------- membership

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  isActive  Boolean     @default(true)

  invitedById String?
  joinedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

/// Invitation to join a project. Only the SHA-256 of the token is stored, so a
/// database leak cannot be replayed as a working invite link.
model ProjectInvitation {
  id        String           @id @default(cuid())
  projectId String
  email     String
  name      String?
  role      ProjectRole      @default(CLIENT_OWNER)
  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)

  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  lastSentAt       DateTime?
  sendCount        Int       @default(0)

  invitedById String
  createdAt   DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([email])
  @@map("project_invitations")
}

// ------------------------------------------------------------ payment requests

/// A client-submitted claim that money was paid. It is NOT money in the books:
/// nothing posts to the ledger until an admin approves it, at which point a
/// real Payment is created through the normal invoice settlement path.
model PaymentRequest {
  id        String @id @default(cuid())
  projectId String
  invoiceId String?

  submittedByUserId String
  amount            Decimal       @db.Decimal(18, 2)
  currency          String        @default("INR")
  paidAt            DateTime
  method            PaymentMethod @default(BANK_TRANSFER)
  reference         String?
  reason            String
  notes             String?
  /// Private storage key for the uploaded proof — never a public URL.
  proofKey          String?
  proofFilename     String?
  proofMimeType     String?

  status           PaymentRequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  /// Set once approved — links the request to the money actually recorded.
  paymentId        String?              @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  submittedBy User     @relation("PaymentRequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?    @relation("PaymentRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([status, createdAt])
  @@map("payment_requests")
}

// ------------------------------------------------------------------ QA / bugs

model Bug {
  id        String @id @default(cuid())
  projectId String
  /// Per-project sequence, rendered as BUG-0048.
  number    Int
  key       String

  title            String
  description      String
  expectedBehavior String?
  actualBehavior   String?
  stepsToReproduce String?

  priority BugPriority @default(MEDIUM)
  severity BugSeverity @default(MAJOR)
  status   BugStatus   @default(SUBMITTED)

  module      String?
  environment String?
  browser     String?
  device      String?
  os          String?
  url         String?

  reportedByUserId String
  assignedToUserId String?
  duplicateOfId    String?

  acknowledgedAt DateTime?
  dueDate        DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  /// Internal-only triage note, never exposed on client routes.
  internalNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy  User    @relation("BugReporter", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  assignedTo  User?   @relation("BugAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  duplicateOf Bug?    @relation("BugDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Bug[]   @relation("BugDuplicates")

  comments    BugComment[]
  attachments BugAttachment[]
  activities  BugActivity[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, severity])
  @@index([assignedToUserId])
  @@map("bugs")
}

model BugComment {
  id       String  @id @default(cuid())
  bugId    String
  authorId String
  body     String
  /// Internal comments must never reach a client route. Enforced in the
  /// service layer, not just hidden in the UI.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bug    Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([bugId, isInternal])
  @@map("bug_comments")
}

model BugAttachment {
  id           String  @id @default(cuid())
  bugId        String
  uploadedById String
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  bug        Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@map("bug_attachments")
}

/// Append-only timeline for a bug. Field/old/new make status changes readable
/// without diffing snapshots.
model BugActivity {
  id       String  @id @default(cuid())
  bugId    String
  actorId  String?
  action   String
  field    String?
  oldValue String?
  newValue String?
  /// Activity on internal-only changes is hidden from client routes.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  bug   Bug   @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bugId, createdAt])
  @@map("bug_activities")
}

// ----------------------------------------------------------------- documents

model ProjectDocument {
  id          String             @id @default(cuid())
  projectId   String
  name        String
  description String?
  category    DocumentCategory   @default(OTHER)
  version     String?
  visibility  DocumentVisibility @default(ADMIN_ONLY)
  allowDownload Boolean          @default(true)

  /// Path inside private storage. Files are streamed through an authorised
  /// endpoint — they are never served from the public /uploads route.
  storageKey String
  filename   String
  mimeType   String
  sizeBytes  Int
  checksum   String?

  uploadedById  String
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  downloads  DocumentDownload[]

  @@index([projectId, visibility])
  @@index([projectId, category])
  @@map("project_documents")
}

model DocumentDownload {
  id         String  @id @default(cuid())
  documentId String
  userId     String
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_downloads")
}

// ------------------------------------------------------------------ delivery

model ProjectDelivery {
  id        String                @id @default(cuid())
  projectId String                @unique
  status    ProjectDeliveryStatus @default(NOT_STARTED)
  version   String?

  sourceCodeMethod SourceCodeMethod @default(NOT_CHOSEN)

  // GitHub handover
  githubRepoUrl    String?
  githubOwner      String?
  githubUsername   String?
  handoverStatus   HandoverStatus @default(NOT_STARTED)
  transferNotes    String?
  transferredAt    DateTime?

  // ZIP handover — private storage only.
  zipStorageKey String?
  zipFilename   String?
  zipSizeBytes  Int?
  zipChecksum   String?
  zipVersion    String?
  zipDownloadCount Int @default(0)

  releaseNotes String?

  adminConfirmedAt    DateTime?
  adminConfirmedById  String?
  clientConfirmedAt   DateTime?
  clientConfirmedById String?
  deliveredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adminConfirmedBy  User?   @relation("DeliveryAdminConfirmer", fields: [adminConfirmedById], references: [id], onDelete: SetNull)
  clientConfirmedBy User?   @relation("DeliveryClientConfirmer", fields: [clientConfirmedById], references: [id], onDelete: SetNull)

  checklist DeliveryChecklistItem[]
  versions  DeliveryVersion[]

  @@map("project_deliveries")
}

model DeliveryChecklistItem {
  id         String  @id @default(cuid())
  deliveryId String
  /// Stable machine key so readiness rules can reference an item by name.
  key        String
  label      String
  isComplete Boolean @default(false)
  isRequired Boolean @default(true)
  sortOrder  Int     @default(0)

  completedAt   DateTime?
  completedById String?
  note          String?

  delivery    ProjectDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  completedBy User?           @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([deliveryId, key])
  @@map("delivery_checklist_items")
}

model DeliveryVersion {
  id           String           @id @default(cuid())
  deliveryId   String
  version      String
  releaseNotes String?
  sourceMethod SourceCodeMethod @default(NOT_CHOSEN)

  storageKey String?
  filename   String?
  sizeBytes  Int?
  checksum   String?
  githubUrl  String?

  publishedById String
  publishedAt   DateTime  @default(now())
  clientConfirmedAt DateTime?

  delivery    ProjectDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  publishedBy User            @relation(fields: [publishedById], references: [id], onDelete: Cascade)

  @@unique([deliveryId, version])
  @@map("delivery_versions")
}

// ------------------------------------------------------------- announcements

model Announcement {
  id        String  @id @default(cuid())
  projectId String
  title     String
  body      String
  isPinned  Boolean @default(false)

  publishedById String
  publishedAt   DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishedBy User    @relation(fields: [publishedById], references: [id], onDelete: Cascade)

  @@index([projectId, publishedAt])
  @@map("announcements")
}

// ------------------------------------------------------- activity & email log

/// Per-project audit trail. Distinct from ActivityLog, which tracks the
/// internal workspace: this one is scoped to a project and readable by its
/// members.
model ProjectActivity {
  id         String  @id @default(cuid())
  projectId  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  field      String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  /// Internal actions are filtered out of the client-facing timeline.
  isInternal Boolean @default(false)
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@map("project_activities")
}

/// Delivery record for every notification email, so an admin can answer
/// "did the client actually get told?" without guessing.
model EmailLog {
  id        String         @id @default(cuid())
  userId    String?
  projectId String?
  event     String
  toAddress String
  subject   String
  status    EmailLogStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([event, status])
  @@map("email_logs")
}
