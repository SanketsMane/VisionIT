// ============================================================================
// Vision IT Infra — Platform Data Model
// Portfolio Catalog · Invoicing · AI Email · Double-Entry Accounting
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

