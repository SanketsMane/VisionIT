  amount      Decimal?      @db.Decimal(18, 2)
  dueDate     DateTime?
  completedAt DateTime?
  status      ProjectStatus @default(PLANNING)
  sortOrder   Int           @default(0)
  invoiced    Boolean       @default(false)

