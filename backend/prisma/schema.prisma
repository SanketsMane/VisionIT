// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  avatarUrl    String?
  phone        String?
  designation  String?
  timezone     String   @default("Asia/Kolkata")
  locale       String   @default("en-IN")
  isActive     Boolean  @default(true)
  emailVerified Boolean @default(false)

  /// INTERNAL users own a workspace; CLIENT users are portal guests who reach
  /// projects only through a ProjectMember row.
  userType UserType @default(INTERNAL)
  /// For CLIENT users: the internal user whose workspace they were invited to.
  ownerId  String?

  lastLoginAt          DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  emailVerifyToken     String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  company        CompanyProfile?
  clients        Client[]
  projects       Project[]
  invoices       Invoice[]
  payments       Payment[]
  expenses       Expense[]
  accounts       Account[]
  journalEntries JournalEntry[]
  emailAccounts  EmailAccount[]
  emailMessages  EmailMessage[]
  emailTemplates EmailTemplate[]
  aiGenerations  AiGeneration[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  files          FileAsset[]
  numberSequences NumberSequence[]
  expenseCategories ExpenseCategory[]

  // ---- Client portal -------------------------------------------------------
  owner          User?  @relation("WorkspaceGuests", fields: [ownerId], references: [id], onDelete: Cascade)
  guests         User[] @relation("WorkspaceGuests")

  memberships       ProjectMember[]
  sentInvitations   ProjectInvitation[] @relation("InvitationSender")
  acceptedInvitation ProjectInvitation[] @relation("InvitationAcceptor")

  paymentRequests   PaymentRequest[] @relation("PaymentRequestSubmitter")
  reviewedRequests  PaymentRequest[] @relation("PaymentRequestReviewer")

  reportedBugs      Bug[]         @relation("BugReporter")
  assignedBugs      Bug[]         @relation("BugAssignee")
  bugComments       BugComment[]
  bugActivities     BugActivity[]
  bugAttachments    BugAttachment[]

  // ---- Services --------------------------------------------------------------
  services          Service[]
  coupons           Coupon[]
  serviceOrders     ServiceOrder[] @relation("OrderVendor")
  placedOrders      ServiceOrder[] @relation("OrderClient")
  reviewedOrders    ServiceOrder[] @relation("OrderReviewer")
  orderMessages     ServiceOrderMessage[]
  quoteRequests     QuoteRequest[] @relation("QuoteRequester")
  ownedQuotes       QuoteRequest[] @relation("QuoteOwner")
  assignedQuotes    QuoteRequest[] @relation("QuoteAssignee")

  // ---- Chat ----------------------------------------------------------------
  conversationsCreated Conversation[]            @relation("ConversationCreator")
  conversations        ConversationParticipant[]
  messagesSent         Message[]                 @relation("MessageSender")

  uploadedDocuments ProjectDocument[]  @relation("DocumentUploader")
  documentDownloads DocumentDownload[]

  deliveryAdminConfirmations  ProjectDelivery[] @relation("DeliveryAdminConfirmer")
  deliveryClientConfirmations ProjectDelivery[] @relation("DeliveryClientConfirmer")
  checklistCompletions        DeliveryChecklistItem[]
  publishedVersions           DeliveryVersion[]

  announcements     Announcement[]
  projectActivities ProjectActivity[]
  emailLogs         EmailLog[]

  @@index([email])
  @@index([ownerId, userType])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Business identity printed on invoices, quotes and outbound email signatures.
model CompanyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  legalName   String
  tradeName   String?
  logoUrl     String?
  signatureUrl String?
  email       String?
  phone       String?
  website     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("India")

  taxLabel     String? @default("GSTIN")
  taxNumber    String?
  panNumber    String?
  cinNumber    String?

  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankSwift         String?
  upiId             String?

  baseCurrency     String @default("INR")
  fiscalYearStartMonth Int @default(4)
  defaultTaxRate   Decimal @default(18) @db.Decimal(6, 3)
  defaultPaymentTerms Int  @default(15)
  invoiceFooterNote String?
  defaultTerms      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

// ============================================================================
// CRM — CLIENTS
// ============================================================================

model Client {
  id          String       @id @default(cuid())
  userId      String
  name        String
  companyName String?
  email       String?
  phone       String?
  website     String?
  status      ClientStatus @default(ACTIVE)
  currency    String       @default("INR")
  taxNumber   String?

  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String?

  paymentTermsDays Int     @default(15)
  notes            String?
  avatarUrl        String?
  tags             String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts ClientContact[]
  projects Project[]
  invoices Invoice[]
  emails   EmailMessage[]

  @@index([userId, status])
  @@index([userId, name])
  @@map("clients")
  serviceOrders ServiceOrder[]
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ============================================================================
// PORTFOLIO — PROJECT CATALOG
// ============================================================================

model Project {
  id          String            @id @default(cuid())
  userId      String
  clientId    String?
  title       String
  slug        String
  /// Human-facing reference used on handover records, e.g. ECH-2026-001.
  code        String?
  logoUrl     String?
  summary     String?
  description String?
  category    ProjectCategory   @default(WEB_DEVELOPMENT)
  status      ProjectStatus     @default(IN_PROGRESS)
  visibility  ProjectVisibility @default(PUBLIC)
  engagement  EngagementModel   @default(FIXED_PRICE)

  startDate    DateTime?
  endDate      DateTime?
  deliveryDate DateTime?

  contractValue Decimal? @db.Decimal(18, 2)
  hourlyRate    Decimal? @db.Decimal(18, 2)
  estimatedHours Decimal? @db.Decimal(10, 2)
  loggedHours    Decimal  @default(0) @db.Decimal(10, 2)
  currency      String   @default("INR")

  coverImageUrl String?
  galleryUrls   String[] @default([])
  liveUrl       String?
  repoUrl       String?
  caseStudyUrl  String?
  playStoreUrl  String?
  appStoreUrl   String?

  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  tags        String[] @default([])
  challenges  String?
  solution    String?
  outcome     String?
  testimonial String?
  testimonialAuthor String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  technologies ProjectTechnology[]
  milestones   ProjectMilestone[]
  invoices     Invoice[]
  expenses     Expense[]

  // ---- Client portal -------------------------------------------------------
  members         ProjectMember[]
  invitations     ProjectInvitation[]
  paymentRequests PaymentRequest[]
  bugs            Bug[]
  documents       ProjectDocument[]
  delivery        ProjectDelivery?
  announcements   Announcement[]
  activities      ProjectActivity[]
  support         ProjectSupport?
  conversations   Conversation[]

  @@unique([userId, slug])
  @@unique([userId, code])
  @@index([userId, category])
  @@index([userId, status])
  @@index([userId, featured])
  @@map("projects")
}

enum ServiceCategory {
  WEB_DEVELOPMENT
  ANDROID_APP
  IOS_APP
  AI_SOFTWARE
  FINTECH_PLATFORM
  TRADING_PLATFORM
  ALGO_TRADING
  AI_AGENT
  AUTOMATION
  MEDIA_GENERATION
  SMS_SERVICE
  VPS_HOSTING
  WINDOWS_HOSTING
  SOCIAL_MEDIA
  DIGITAL_MARKETING
  SEO
  LEAD_GENERATION
  OTHER
}

/// How a service is priced, which decides what the catalog card shows.
enum PricingModel {
  /// No figure at all — scope varies too much to publish one.
  QUOTE_ONLY
  /// "Starting from Rs X" with a quote button.
  FROM
  /// A single fixed price.
  FIXED
  /// Has plans with per-term prices, e.g. the VPS tiers.
  TIERED
  /// Priced by how much you spend: the client enters an amount and the rate
  /// improves as it rises. Used for SMS credits.
  SLAB
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Something the studio sells. Distinct from Project, which is work already won.
model Service {
  id       String          @id @default(cuid())
  userId   String
  /// Stable, human-readable key used in public URLs.
  slug     String
  name     String
  tagline  String?
  description String?
  category ServiceCategory
  pricingModel PricingModel @default(QUOTE_ONLY)

  /// Lucide icon name, so the catalog needs no image to look finished.
  icon        String?
  coverImageUrl String?
  accentColor String?

  features     String[] @default([])
  deliverables String[] @default([])

  /// Used by FROM and FIXED. TIERED services derive theirs from the cheapest plan.
  startingPrice Decimal? @db.Decimal(18, 2)
  currency      String   @default("INR")
  /// Rendered after the price: "/mo", "/project", "per campaign".
  priceSuffix   String?

  /// SLAB pricing only: the smallest top-up accepted, and what a unit is
  /// called so the calculator can say "2,352 SMS" rather than "2,352 units".
  minOrderAmount Decimal? @db.Decimal(18, 2)
  unitLabel      String?
  /// A short line under the price — "No DLT registration required" and the like.
  priceNote      String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  /// Whether it appears on the public catalog as well as internally.
  isPublic   Boolean @default(true)
  sortOrder  Int     @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans  ServicePlan[]
  quotes QuoteRequest[]
  orders ServiceOrder[]
  slabs  ServicePriceSlab[]

  @@unique([userId, slug])
  @@index([userId, category])
  @@map("services")
}

/// A volume band: spend this much, get this rate.
///
/// A row per band rather than a formula, for the same reason plan prices are
/// rows — the breakpoints are a commercial decision that moves, and the studio
/// should be able to change them without a deploy.
model ServicePriceSlab {
  id        String @id @default(cuid())
  serviceId String

  /// Inclusive floor. The top band leaves `maxAmount` null for "and above".
  minAmount Decimal  @db.Decimal(18, 2)
  maxAmount Decimal? @db.Decimal(18, 2)
  /// Cost of one unit at this band — ₹0.85 per SMS, and so on.
  unitPrice Decimal  @db.Decimal(18, 4)
  /// Free text because "8 Years" is a marketing promise, not a computed date.
  validityLabel String?

  sortOrder Int @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, minAmount])
  @@map("service_price_slabs")
}

/// A tier within a service — KVM 1, KVM 2, and so on.
model ServicePlan {
  id        String @id @default(cuid())
  serviceId String
  name      String
  slug      String
  summary   String?

  /// Free-form spec rows rendered in order: vCPU, RAM, disk, bandwidth.
  /// Kept as JSON because the shape differs per service and a column per
  /// possible spec would be mostly nulls.
  specs Json?

  features   String[] @default([])
  isPopular  Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  prices  ServicePlanPrice[]
  orders  ServiceOrder[]

  @@unique([serviceId, slug])
  @@map("service_plans")
}

/// One price for one plan on one billing term.
///
/// A row per term rather than a formula: the ladder between monthly, annual and
/// two-year is a commercial decision that changes with promotions, and encoding
/// it as arithmetic would mean a deploy every time a price moves.
model ServicePlanPrice {
  id     String @id @default(cuid())
  planId String

  /// 1, 12 or 24. Stored as a number so new terms need no migration.
  termMonths Int
  /// What the client pays per month on this term.
  price Decimal @db.Decimal(18, 2)
  /// What it renews at once the introductory term ends.
  renewalPrice Decimal? @db.Decimal(18, 2)
  /// The competitor or list price shown struck through, and where the headline
  /// discount percentage comes from.
  compareAtPrice Decimal? @db.Decimal(18, 2)
  setupFee       Decimal? @db.Decimal(18, 2)

  currency String @default("INR")

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, termMonths])
  @@map("service_plan_prices")
}

/// An enquiry from the "Get a quote" button.
model QuoteRequest {
  id        String @id @default(cuid())
  /// The studio this was sent to.
  userId    String
  serviceId String?
  planId    String?
  termMonths Int?

  name    String
  email   String
  phone   String?
  company String?
  message String?
  budget  String?
  timeline String?

  status QuoteStatus @default(NEW)
  /// Where it came from: "public" or "portal".
  source String @default("public")

  /// The code the visitor had applied when they enquired, and what it saved
  /// them. Captured at submission because a coupon can expire or change value
  /// afterwards, and the quote should still reflect what they were shown.
  couponCode     String?
  discountAmount Decimal? @db.Decimal(18, 2)
  quotedPrice    Decimal? @db.Decimal(18, 2)

  /// Set when a signed-in user submitted it, so replies can reach their portal.
  requestedById String?
  assignedToId  String?
  internalNotes String?

  /// Kept for abuse triage — the endpoint is public and rate-limited.
  ipAddress String?
  userAgent String?

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User     @relation("QuoteOwner", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("QuoteRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo  User?    @relation("QuoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@map("quote_requests")
}

/// Named for coupons specifically: `DiscountType` is already taken by invoice
/// line discounts, which carry a NONE case this one has no use for.
/// Where an order sits between "I want this" and "it is running".
enum ServiceOrderStatus {
  /// Client asked for a price on something that is not publicly priced.
  QUOTE_REQUESTED
  /// The studio has set a price for this client specifically.
  QUOTED
  /// Price is known and agreed; waiting for the client to pay.
  AWAITING_PAYMENT
  /// Client has uploaded proof; waiting on the studio to verify it.
  PAYMENT_SUBMITTED
  /// Paid, verified, and the credentials or bill have gone out.
  ACTIVE
  /// Proof did not check out. The client can submit again.
  REJECTED
  CANCELLED
}

/// A client buying a service.
///
/// Deliberately not an Invoice: an invoice is a document raised for work already
/// agreed, whereas this is the request that precedes it — including the case
/// where nobody knows the price yet. An invoice is raised *from* an order once
/// the money is verified.
model ServiceOrder {
  id          String @id @default(cuid())
  /// Human-readable, quoted in emails and by the client on the phone.
  orderNumber String

  /// The studio being bought from.
  userId       String
  /// The portal account that placed it.
  clientUserId String
  /// The business record, when the client is already on the books.
  clientId     String?

  serviceId  String
  planId     String?
  termMonths Int?

  /// What the catalog said at the time. Frozen here because published prices
  /// move and the order must still show what was agreed.
  listPrice      Decimal  @db.Decimal(18, 2)
  couponCode     String?
  discountAmount Decimal? @db.Decimal(18, 2)
  /// Set by the studio after a quote — a price for this client only.
  customPrice    Decimal? @db.Decimal(18, 2)
  /// What they actually have to pay. Resolved on write so nothing downstream
  /// has to re-derive it from three nullable columns.
  finalPrice     Decimal? @db.Decimal(18, 2)
  currency       String   @default("INR")

  /// SLAB orders: how many units the amount bought, at what rate, and how long
  /// they last. Frozen at purchase — the bands move, and a top-up bought last
  /// year keeps the rate it was sold at.
  quantity      Int?
  unitPrice     Decimal? @db.Decimal(18, 4)
  validityLabel String?

  /// What the client told us they need.
  requirements String?
  /// Where credentials and bills should be sent. Often a personal Gmail rather
  /// than the address they signed in with, so it is captured per order.
  deliveryEmail String

  // ---- Payment proof -------------------------------------------------------
  paymentMethod    PaymentMethod?
  paymentReference String?
  paidAt           DateTime?
  /// Private storage key. Never a public URL.
  proofKey         String?
  proofFilename    String?
  proofMimeType    String?
  submittedAt      DateTime?

  // ---- Review --------------------------------------------------------------
  status          ServiceOrderStatus @default(AWAITING_PAYMENT)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  /// The invoice raised once the money was verified.
  invoiceId       String?

  // ---- Delivery ------------------------------------------------------------
  /// Server credentials and the like, encrypted at rest with the same key that
  /// protects stored SMTP passwords. Held so the studio can resend, and
  /// decrypted only when it is being shown or emailed.
  credentialsEncrypted String?
  deliveryNote         String?
  deliveredAt          DateTime?
  /// When the term ends, for renewals.
  expiresAt            DateTime?

  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                  @relation("OrderVendor", fields: [userId], references: [id], onDelete: Cascade)
  clientUser User                  @relation("OrderClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  reviewedBy User?                 @relation("OrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  client     Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service    Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  plan       ServicePlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  messages   ServiceOrderMessage[]

  @@unique([userId, orderNumber])
  @@index([userId, status, createdAt])
  @@index([clientUserId, createdAt])
  @@map("service_orders")
}

/// Questions on an order — the "ask for help" thread.
///
/// Separate from project chat because an order is not a project: a client
/// buying hosting may have no project at all, and the studio wants these
/// beside the order rather than buried in a conversation list.
model ServiceOrderMessage {
  id      String @id @default(cuid())
  orderId String

  authorId String
  body     String
  /// Studio-only notes share the thread but never reach the client.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  order  ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("service_order_messages")
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

/// What a coupon is allowed to touch.
enum CouponScope {
  ALL
  CATEGORY
  SERVICE
}

/// A discount code applied on top of a published price.
///
/// Prices in the catalog are the list prices a visitor sees unprompted; the
/// coupon is what turns them into the offer. Keeping the two apart means the
/// public page never has to lie about the standard rate, and a promotion can
/// start or end without rewriting the catalog.
model Coupon {
  id     String @id @default(cuid())
  userId String

  /// Stored uppercase and matched case-insensitively — people type them by hand.
  code        String
  description String?

  discountType  CouponDiscountType @default(PERCENT)
  /// Percent (0-100) or a rupee amount, depending on `discountType`.
  discountValue Decimal      @db.Decimal(18, 2)
  /// Ceiling on a percent discount, so a big plan cannot give away too much.
  maxDiscountAmount Decimal? @db.Decimal(18, 2)

  scope      CouponScope       @default(ALL)
  categories ServiceCategory[] @default([])
  serviceIds String[]          @default([])

  /// Only valid on terms at least this long, for "annual plans only" offers.
  minTermMonths Int?

  startsAt DateTime?
  endsAt   DateTime?

  /// Null means unlimited. `usedCount` is incremented when a quote cites it.
  usageLimit Int?
  usedCount  Int  @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, isActive])
  @@map("coupons")
}

enum ConversationType {
  /// Two people. Exactly one exists per pair per project.
  DIRECT
  /// A named room the client can add their own teammates to.
  GROUP
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  /// "X added Y", "X left" — rendered as a centred note, has no sender.
  SYSTEM
}

/// A chat thread, always inside one project.
///
/// Scoping to a project rather than the workspace is what makes access control
/// tractable: membership of the project is already resolved on every portal
/// request, so "can this person be in this conversation?" reduces to a question
/// the system can already answer.
model Conversation {
  id          String           @id @default(cuid())
  projectId   String
  type        ConversationType @default(DIRECT)
  /// Groups only; a direct thread is named after the other person.
  title       String?
  avatarUrl   String?
  createdById String

  /// Denormalised so the conversation list sorts and previews without a
  /// correlated subquery per row. Written in the same transaction as the
  /// message, so it cannot drift.
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastMessageSenderId String?

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([projectId, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)

  joinedAt DateTime  @default(now())
  /// Set instead of deleting the row, so past messages keep a resolvable author
  /// and the "X left" note still has someone to name.
  leftAt   DateTime?

  /// Read state as a high-water mark rather than a receipt row per message per
  /// participant: unread counts and "have they seen it?" both reduce to a
  /// timestamp comparison, and the table stays O(participants) instead of
  /// O(messages x participants).
  lastReadAt      DateTime?
  lastReadMessageId String?
  /// Separate mark so the UI can distinguish delivered from read, the way the
  /// two ticks do.
  lastDeliveredAt DateTime?

  isMuted Boolean @default(false)

  /// When this person was last told about unread messages here. Stops the
  /// digest sweep mailing the same backlog every time it runs, and is cleared
  /// implicitly by reading — a newer message than this mark is notifiable
  /// again.
  lastNotifiedAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  /// Null for SYSTEM messages, which nobody sent.
  senderId       String?
  type           MessageType @default(TEXT)
  body           String?

  replyToId String?

  editedAt  DateTime?
  /// Soft delete so the thread keeps its shape — the bubble becomes
  /// "This message was deleted" rather than silently vanishing for everyone.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String

  /// Path under the private storage root. Never sent to a client — downloads go
  /// through a route that checks participation first.
  storageKey String
  filename   String
  mimeType   String
  sizeBytes  Int
  /// Lets the UI reserve the right box before the image loads.
  width      Int?
  height     Int?

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// Named tiers so the portal can describe what a client is entitled to
/// without the studio retyping it on every project.
enum SupportPlan {
  BASIC
  STANDARD
  PREMIUM
  CUSTOM
}

/// A post-delivery technical support term, e.g. "one year from go-live".
///
/// One row per project: renewing extends this term and bumps `renewalCount`
/// rather than inserting a second row, because the client-facing question is
/// only ever "how much cover do I have left?".
model ProjectSupport {
  id        String @id @default(cuid())
  projectId String @unique

  plan      SupportPlan @default(STANDARD)
  /// Overrides the plan name in the portal, for a bespoke agreement.
  planLabel String?

  startDate      DateTime
  /// Always derived from startDate + durationMonths on write, so the two can
  /// never disagree — the countdown reads this and nothing else.
  endDate        DateTime
  durationMonths Int      @default(12)

  /// Shown verbatim to the client, so they know what support covers.
  inclusions   String[] @default([])
  responseTime String?
  supportEmail String?
  supportPhone String?
  /// Studio-only. Never leaves the internal API.
  notes        String?

  isCancelled Boolean   @default(false)
  cancelledAt DateTime?
  /// Number of times the term has been extended.
  renewalCount Int @default(0)

  /// Which expiry reminders have already gone out, so the daily sweep can't
  /// mail the same warning twice. Values: "30", "7", "1", "expired".
  remindersSent String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([endDate])
  @@map("project_support")
}

model Technology {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  category String?
  iconUrl  String?
  color    String?

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
