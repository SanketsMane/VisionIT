# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
.next/
out/
build/

# Environment — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Working notes, specs and plaintext provider credentials. Kept local: this
# folder holds API keys in the clear, and the rest is not part of the product.
# Anchored with a leading slash so it matches ONLY the top-level folder: git
# on macOS matches ignore rules case-insensitively, and an unanchored "Docs/"
# also swallowed backend/src/docs/ (the Swagger spec).
/Docs/

# Runtime artefacts
logs/
*.log
npm-debug.log*
uploads/*
!uploads/brand/
!uploads/.gitkeep

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Testing
coverage/
.nyc_output/

# Turbo / caches
.turbo/
*.tsbuildinfo
